{%- if section.settings.enable_announcement -%}
  <div style="background: linear-gradient(90deg, var(--color-bg-secondary) 0%, var(--color-border) 50%, var(--color-bg-secondary) 100%); border-bottom: 1px solid var(--color-border); text-align: center; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 500; color: var(--color-accent); letter-spacing: 0.05em; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
    {%- endif -%}

    <span style="display: inline-block; width: 8px; height: 8px; background-color: var(--color-accent); border-radius: 50%; box-shadow: 0 0 8px var(--color-accent);"></span>
    {{ section.settings.text | escape }}

    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "SYSTEM READY: EXPLORE FUTURISTIC SMART TECH DISCOVERIES"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    }
  ]
}
{% endschema %}

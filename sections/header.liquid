<header style="background-color: rgba(11, 15, 25, 0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 100;">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 80px;">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
             alt="{{ shop.name }}"
             width="{{ section.settings.logo_width }}"
             height="auto"
             style="display: block;">
      {%- else -%}
        <span style="font-size: 1.5rem; font-weight: 800; tracking: -0.05em; color: var(--color-text-primary); display: flex; align-items: center; gap: 0.25rem;">
          SMARTIFY <span style="color: var(--color-accent); font-weight: 400;">FINDS</span>
        </span>
      {%- endif -%}
    </a>

    <!-- Navigation Menu (Desktop Nested) -->
    <nav class="hide-mobile" role="navigation">
      <ul style="display: flex; list-style: none; gap: 2rem; margin: 0; padding: 0;">
        {%- for link in section.settings.menu.links -%}
          <li style="position: relative;" class="desktop-menu-item">
            {%- if link.links != blank -%}
              <!-- Level 1 Trigger -->
              <a href="{{ link.url }}" style="color: {% if link.active or link.child_active %}var(--color-accent){% else %}var(--color-text-primary){% endif %}; font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.25rem; padding: 0.5rem 0;">
                {{ link.title }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </a>

              <!-- Level 2 Dropdown -->
              <ul class="dropdown-menu" style="position: absolute; top: 100%; left: 0; min-width: 220px; background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius); padding: 0.75rem 0; list-style: none; display: none; z-index: 110; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
                {%- for child_link in link.links -%}
                  <li style="position: relative;" class="desktop-submenu-item">
                    {%- if child_link.links != blank -%}
                      <!-- Level 2 Trigger -->
                      <a href="{{ child_link.url }}" style="color: {% if child_link.active or child_link.child_active %}var(--color-accent){% else %}var(--color-text-primary){% endif %}; font-weight: 500; font-size: 0.9rem; padding: 0.5rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                        {{ child_link.title }}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>

                      <!-- Level 3 Dropdown -->
                      <ul class="grandchild-dropdown" style="position: absolute; top: 0; left: 100%; min-width: 200px; background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius); padding: 0.75rem 0; list-style: none; display: none; z-index: 120; box-shadow: 0 10px 25px rgba(0,0,0,0.5); margin-left: 2px;">
                        {%- for grandchild_link in child_link.links -%}
                          <li>
                            <a href="{{ grandchild_link.url }}" style="color: {% if grandchild_link.active %}var(--color-accent){% else %}var(--color-text-secondary){% endif %}; font-weight: 400; font-size: 0.85rem; padding: 0.5rem 1.25rem; display: block; hover: color: var(--color-accent);">
                              {{ grandchild_link.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <a href="{{ child_link.url }}" style="color: {% if child_link.active %}var(--color-accent){% else %}var(--color-text-secondary){% endif %}; font-weight: 500; font-size: 0.9rem; padding: 0.5rem 1.25rem; display: block;">
                        {{ child_link.title }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a href="{{ link.url }}" style="color: {% if link.active %}var(--color-accent){% else %}var(--color-text-primary){% endif %}; font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; padding: 0.5rem 0;">
                {{ link.title }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Icons / CTA area -->
    <div style="display: flex; align-items: center; gap: 1.25rem;">
      <!-- Predictive Search Trigger -->
      <button class="search-trigger" style="background: none; border: none; color: var(--color-text-primary); cursor: pointer;" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <!-- Cart Trigger -->
      <a href="{{ routes.cart_url }}" class="cart-icon-trigger" style="position: relative; display: flex; align-items: center; color: var(--color-text-primary);" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span class="cart-count-bubble" style="position: absolute; top: -8px; right: -8px; background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-purple) 100%); color: #000; font-size: 0.7rem; font-weight: 800; width: 18px; height: 18px; border-radius: 50%; display: {% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items: center; justify-content: center;">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Hamburger Menu (Mobile) -->
      <button class="mobile-menu-trigger hide-desktop" style="background: none; border: none; color: var(--color-text-primary); cursor: pointer;" aria-label="Open Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Menu Drawer (Interactive / Collapsible) -->
<div id="mobile-menu" class="drawer" aria-hidden="true" role="dialog">
  <div class="drawer-header">
    <h2 style="font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em;">SMARTIFY NAVIGATION</h2>
    <button class="drawer-close" aria-label="Close Menu">&times;</button>
  </div>
  <div class="drawer-body" style="padding-top: 1rem;">
    <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; padding: 0; margin: 0;">
      {%- for link in section.settings.menu.links -%}
        <li style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
          {%- if link.links != blank -%}
            <!-- Nested Mobile Link Group using details/summary -->
            <details class="mobile-details" style="width: 100%;">
              <summary style="font-size: 1.15rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-primary); display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; user-select: none;">
                {{ link.title }}
                <svg class="details-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <ul style="list-style: none; padding-left: 1.25rem; margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; border-left: 2px solid var(--color-accent);">
                {%- for child_link in link.links -%}
                  <li>
                    {%- if child_link.links != blank -%}
                      <details class="mobile-details" style="width: 100%;">
                        <summary style="font-size: 1rem; font-weight: 600; color: var(--color-text-secondary); display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; user-select: none;">
                          {{ child_link.title }}
                          <svg class="details-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </summary>
                        <ul style="list-style: none; padding-left: 1rem; margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; border-left: 1px dashed var(--color-accent-purple);">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" style="font-size: 0.9rem; font-weight: 500; color: var(--color-text-secondary); display: block; padding: 0.25rem 0;">
                                {{ grandchild_link.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a href="{{ child_link.url }}" style="font-size: 1rem; font-weight: 600; color: var(--color-text-secondary); display: block; padding: 0.25rem 0;">
                        {{ child_link.title }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" style="font-size: 1.15rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-primary); display: block; padding: 0.25rem 0;">
              {{ link.title }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  /* Header Dropdown Custom Styling */
  .desktop-menu-item:hover .dropdown-menu {
    display: block !important;
  }
  .desktop-submenu-item:hover .grandchild-dropdown {
    display: block !important;
  }
  .dropdown-menu a:hover, .grandchild-dropdown a:hover {
    color: var(--color-accent) !important;
    background-color: rgba(255, 255, 255, 0.03);
  }
  .desktop-menu-item > a:hover {
    color: var(--color-accent) !important;
  }
  .desktop-menu-item:hover > a svg {
    transform: rotate(180deg);
  }

  /* Details/Summary animation & hides default arrow */
  details.mobile-details summary::-webkit-details-marker {
    display: none;
  }
  details.mobile-details[open] > summary svg.details-icon {
    transform: rotate(180deg);
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

<footer style="background-color: var(--color-bg-secondary); border-top: 1px solid var(--color-border); padding: 5rem 0 3rem 0; font-size: 0.95rem; color: var(--color-text-secondary);">
  <div class="container">
    <div class="grid grid-4" style="margin-bottom: 4rem;">

      <!-- Brand column -->
      <div>
        <h3 style="font-size: 1.25rem; color: var(--color-text-primary); margin-bottom: 1.25rem; font-weight: 800;">
          SMARTIFY <span style="color: var(--color-accent);">FINDS</span>
        </h3>
        <p style="line-height: 1.6; margin-bottom: 1.5rem;">
          Your modern destination for premium, futuristic tech gadgets and high-performance electronic essentials.
        </p>

        <!-- Social Icons -->
        <div style="display: flex; gap: 1rem;">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" style="color: var(--color-text-primary);" aria-label="Facebook">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" style="color: var(--color-text-primary);" aria-label="Instagram">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter != blank -%}
            <a href="{{ settings.social_twitter }}" style="color: var(--color-text-primary);" aria-label="Twitter">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Quick links columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div>
            <h4 style="font-size: 1rem; color: var(--color-text-primary); margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.05em;">
              {{ block.settings.heading | escape }}
            </h4>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
              {%- for link in block.settings.menu.links -%}
                <li>
                  <a href="{{ link.url }}" style="color: var(--color-text-secondary); text-decoration: none;">
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Newsletter column -->
      <div>
        <h4 style="font-size: 1rem; color: var(--color-text-primary); margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.05em;">
          Future Updates
        </h4>
        <p style="margin-bottom: 1.25rem; line-height: 1.6;">
          Receive premium updates about newly formulated gadgets and modern discoveries.
        </p>

        {%- form 'customer', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" style="background: var(--color-bg-primary);" required>
            <button type="submit" class="btn btn-primary" style="width: 100%;">
              {{ 'general.newsletter.button' | t }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="color: var(--color-accent); font-size: 0.85rem; margin-top: 0.5rem;">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <!-- Divider -->
    <div style="height: 1px; background-color: var(--color-border); margin-bottom: 2rem;"></div>

    <!-- Bottom area -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.85rem;">
      <p>&copy; {{ 'now' | date: '%Y' }} Smartify Finds. Powered by Shopify.</p>

      <!-- Payment Icons Placeholder -->
      <div style="display: flex; gap: 0.5rem;">
        <span style="border: 1px solid var(--color-border); padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.75rem;">VISA</span>
        <span style="border: 1px solid var(--color-border); padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.75rem;">MC</span>
        <span style="border: 1px solid var(--color-border); padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.75rem;">AMEX</span>
        <span style="border: 1px solid var(--color-border); padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 700; font-size: 0.75rem;">PAYPAL</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop Smartify"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Link List",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}

<section class="container" style="padding: 8rem 0; text-align: center;">

  <div style="font-size: 5rem; margin-bottom: 1.5rem;">🌌</div>

  <h1 class="glow-text" style="font-size: 3.5rem; font-weight: 900; margin-bottom: 1rem;">
    404: System Not Found
  </h1>

  <p class="text-secondary" style="font-size: 1.2rem; max-width: 500px; margin: 0 auto 3rem auto; line-height: 1.6;">
    The coordinates you are requesting do not exist in our gadget discovery index. It might have been re-calibrated or moved.
  </p>

  <a href="{{ routes.root_url }}" class="btn btn-primary">
    Return to Base Station
  </a>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}

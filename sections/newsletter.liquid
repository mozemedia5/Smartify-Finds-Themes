<section style="background: linear-gradient(180deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%); padding: 6rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container" style="max-width: 650px; text-align: center;">

    <div style="width: 64px; height: 64px; border-radius: 50%; background: radial-gradient(circle, var(--color-accent) 0%, transparent 80%); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; border: 1px solid var(--color-border);">
      📧
    </div>

    <h2 style="font-size: 2.25rem; font-weight: 900; margin-bottom: 1rem; letter-spacing: -0.02em;">
      {{ section.settings.heading | escape }}
    </h2>

    <p class="text-secondary" style="margin-bottom: 2.5rem; line-height: 1.6;">
      {{ section.settings.description | escape }}
    </p>

    {%- form 'customer', id: 'SectionNewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display: flex; flex-direction: column; gap: 0.75rem; max-width: 450px; margin: 0 auto;">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" style="background: var(--color-bg-primary);" required>
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          {{ 'general.newsletter.button' | t }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="color: var(--color-accent); font-size: 0.9rem; margin-top: 1rem;">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Discovery Program"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to receive premium briefings on newly formulated digital gadgets, limited-edition tech drops, and exclusive community member updates."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

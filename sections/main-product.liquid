{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}

<article class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  {% render 'breadcrumbs' %}

  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rem; margin-top: 2rem; @media(max-width:768px){ grid-template-columns:1fr; gap:2rem; }">

    <!-- Gallery -->
    <div>
      <div style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius); overflow: hidden; aspect-ratio: 1/1; position: relative;">
        {%- if product.featured_media != blank -%}
          <img src="{{ product.featured_media | image_url: width: 1000 }}"
               alt="{{ product.featured_media.alt | escape }}"
               width="1000"
               height="1000"
               style="object-fit: cover; width: 100%; height: 100%;"
               id="MainProductImage">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <!-- Multi-media thumbnails -->
      {%- if product.media.size > 1 -%}
        <div style="display: flex; gap: 1rem; margin-top: 1rem; overflow-x: auto;">
          {%- for media in product.media -%}
            <button onclick="document.getElementById('MainProductImage').src='{{ media | image_url: width: 1000 }}'" style="width: 80px; height: 80px; border: 1px solid var(--color-border); border-radius: var(--border-radius); background: none; padding: 0; cursor: pointer; overflow: hidden; flex-shrink: 0;">
              <img src="{{ media | image_url: width: 150 }}" width="150" height="150" style="width: 100%; height: 100%; object-fit: cover;" alt="Thumbnail">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Form Wrapper around the whole interactive column -->
    {%- form 'product', product, class: 'product-single-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      <script type="application/json" data-variants-json>
        {{ product.variants | json }}
      </script>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                <p style="font-size: 0.85rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.5rem;">
                  {{ product.vendor | default: 'Smartify Finds' }}
                </p>
                <h1 style="font-size: 2.5rem; font-weight: 900; line-height: 1.2; letter-spacing: -0.02em;">
                  {{ product.title | escape }}
                </h1>
              </div>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }} style="display: flex; align-items: baseline; gap: 1rem;">
                <span class="product-price" style="font-size: 1.75rem; font-weight: 800; color: var(--color-accent);">{{ price | money }}</span>
                {%- if on_sale -%}
                  <span style="text-decoration: line-through; font-size: 1.25rem; color: var(--color-text-secondary);">{{ compare_at_price | money }}</span>
                  <span class="badge badge-sale">{{ 'general.products.sale' | t }}</span>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              <div {{ block.shopify_attributes }}>
                {%- unless product.has_only_default_variant -%}
                  <div class="variant-picker" style="display: flex; flex-direction: column; gap: 1rem;">
                    {%- for option in product.options_with_values -%}
                      <div>
                        <span style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-secondary); display: block; margin-bottom: 0.5rem;">
                          {{ option.name }}:
                        </span>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                          {%- for value in option.values -%}
                            <label style="cursor: pointer;">
                              <input type="radio" name="option-{{ option.name | handle }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} class="sr-only">
                              <span style="display: inline-block; padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: var(--border-radius); font-size: 0.9rem; font-weight: 600; color: var(--color-text-primary); transition: all 0.2s ease;">
                                {{ value }}
                              </span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
              </div>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                  <div style="width: 120px;">
                    <label for="Quantity-{{ section.id }}" class="sr-only">{{ 'general.cart.quantity' | t }}</label>
                    <input type="number" name="quantity" id="Quantity-{{ section.id }}" value="1" min="1" style="height: 100%;">
                  </div>
                  <button type="submit" class="btn btn-primary" style="flex: 1;" {% unless product.available %}disabled{% endunless %}>
                    <span class="btn-text">
                      {%- if product.available -%}
                        {{ 'general.cart.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'general.cart.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                </div>
              </div>

            {%- when 'description' -%}
              <div {{ block.shopify_attributes }} class="text-secondary" style="line-height: 1.7; font-size: 1rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-top: 1rem;">
                {{ product.description }}
              </div>

            {%- when 'tech_specifications' -%}
              <div {{ block.shopify_attributes }} style="margin-top: 1rem; border: 1px solid var(--color-border); border-radius: var(--border-radius); padding: 1.5rem; background-color: var(--color-bg-secondary);">
                <h3 style="font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; color: var(--color-accent);">
                  ⚙️ {{ 'general.products.specifications' | t }}
                </h3>
                <p class="text-secondary" style="font-size: 0.9rem; line-height: 1.6;">
                  {{ block.settings.specs_text | escape | newline_to_br }}
                </p>
              </div>

            {%- when 'whats_in_box' -%}
              <div {{ block.shopify_attributes }} style="margin-top: 1rem; border: 1px solid var(--color-border); border-radius: var(--border-radius); padding: 1.5rem; background-color: var(--color-bg-secondary);">
                <h3 style="font-size: 1.1rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; color: var(--color-accent-purple);">
                  📦 {{ 'general.products.whats_in_box' | t }}
                </h3>
                <p class="text-secondary" style="font-size: 0.9rem; line-height: 1.6;">
                  {{ block.settings.content | escape | newline_to_br }}
                </p>
              </div>

          {%- endcase -%}
        {%- endfor -%}

      </div>
    {%- endform -%}

  </div>
</article>

{% schema %}
{
  "name": "Product Details",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "tech_specifications",
      "name": "Technical Specs",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "specs_text",
          "label": "Specifications Specifications",
          "default": "Dimensions: 120mm x 80mm x 45mm\nWeight: 145g\nPower Delivery: 65W Max\nConnectivity: Bluetooth 5.2 Low Energy"
        }
      ]
    },
    {
      "type": "whats_in_box",
      "name": "What's in the Box",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "content",
          "label": "Included Items",
          "default": "- 1x Smartify Finds Premium Device\n- 1x Fast Charge USB-C Cable\n- 1x Magnetic Modular Base\n- 1x Welcome Guide & User Manual"
        }
      ]
    }
  ]
}
{% endschema %}

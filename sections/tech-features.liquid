<section style="background-color: var(--color-bg-secondary); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 5rem 0;">
  <div class="container">

    <div style="text-align: center; max-width: 650px; margin: 0 auto 4rem auto;">
      <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em;">
        {{ section.settings.subheading | escape }}
      </span>
      <h2 style="font-size: 2.25rem; font-weight: 900; margin-top: 0.5rem; margin-bottom: 1rem;">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="text-secondary">
        {{ section.settings.description | escape }}
      </p>
    </div>

    <!-- Interactive Grid Blocks -->
    <div class="grid grid-3">
      {%- for block in section.blocks -%}
        <div class="tech-card" {{ block.shopify_attributes }}>
          <!-- Block Icon / Badge -->
          <div style="width: 48px; height: 48px; border-radius: 8px; background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-purple) 100%); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: #000; font-weight: 900; font-size: 1.2rem;">
            ⚡
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">{{ block.settings.title | escape }}</h3>
          <p class="text-secondary" style="line-height: 1.6; font-size: 0.95rem;">{{ block.settings.description | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Technology Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Intelligent Living"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SPECIFICATION OVERVIEW"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each curated device is rigorously verified against premium technical quality standards, battery density indexes, and integration capability parameters."
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "feature",
      "name": "Technical Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "High-Efficiency Core"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Powered by advanced computational circuitry yielding 30% faster system discovery response."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Ultra-Low Latency", "description": "Equipped with custom high-frequency Bluetooth modules for seamless, lag-free audio transmission." } },
        { "type": "feature", "settings": { "title": "Smart Charge Core", "description": "Intelligent power management delivering balanced, fast voltage delivery without thermal compromises." } },
        { "type": "feature", "settings": { "title": "Ergonomic Architecture", "description": "Sophisticated aluminum styling carefully balanced for maximum daily utility and long-lasting strength." } }
      ]
    }
  ]
}
{% endschema %}

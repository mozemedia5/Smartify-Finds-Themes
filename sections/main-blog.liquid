<section class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  {% render 'breadcrumbs' %}

  <div style="margin-bottom: 4rem;">
    <h1 style="font-size: 2.75rem; font-weight: 900; margin-bottom: 1rem;">
      {{ blog.title }}
    </h1>
  </div>

  {%- paginate blog.articles by 6 -%}
    <div class="grid grid-3">
      {%- for article in blog.articles -%}
        <div class="tech-card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
          <div>
            {%- if article.image -%}
              <a href="{{ article.url }}" style="display: block; overflow: hidden; border-radius: var(--border-radius); margin-bottom: 1.25rem; aspect-ratio: 16/10;">
                <img src="{{ article.image | image_url: width: 600 }}"
                     alt="{{ article.title | escape }}"
                     width="600"
                     height="375"
                     loading="lazy"
                     style="object-fit: cover; width: 100%; height: 100%; transition: transform 0.3s ease;"
                     onmouseover="this.style.transform='scale(1.03)'"
                     onmouseout="this.style.transform='scale(1)'">
              </a>
            {%- endif -%}

            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; display: block; margin-bottom: 0.5rem;">
              {{ article.published_at | date: '%b %d, %Y' }}
            </span>

            <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.3;">
              <a href="{{ article.url }}" style="color: var(--color-text-primary); text-decoration: none;">{{ article.title }}</a>
            </h2>

            <p class="text-secondary" style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
              {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
            </p>
          </div>

          <a href="{{ article.url }}" style="font-weight: 700; font-size: 0.9rem; color: var(--color-accent-purple); display: inline-flex; align-items: center; gap: 0.25rem;">
            Read Full Briefing &rarr;
          </a>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 4rem;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog Listings",
  "settings": []
}
{% endschema %}

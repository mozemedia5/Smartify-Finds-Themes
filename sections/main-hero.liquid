<section style="position: relative; background-color: var(--color-bg-primary); overflow: hidden; min-height: calc(100vh - 120px); display: flex; align-items: center;">

  <!-- Full Background Image Layout Option -->
  {%- if section.settings.layout_type == 'background' and section.settings.image != blank -%}
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           alt="{{ section.settings.heading | escape }}"
           width="2000"
           height="1000"
           loading="eager"
           style="object-fit: cover; width: 100%; height: 100%; opacity: {{ section.settings.image_opacity | divided_by: 100.0 }}; filter: grayscale(10%);">
    </div>
  {%- endif -%}

  <!-- Glow aesthetic overlays -->
  <div style="position: absolute; top: -10%; left: -10%; width: 50%; height: 50%; background: radial-gradient(circle, rgba(0, 240, 255, 0.15) 0%, transparent 70%); z-index: 2; pointer-events: none;"></div>
  <div style="position: absolute; bottom: -10%; right: -10%; width: 50%; height: 50%; background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 70%); z-index: 2; pointer-events: none;"></div>

  <!-- Content & Split Screen Layout Container -->
  <div class="container" style="position: relative; z-index: 5; padding-top: 5rem; padding-bottom: 5rem; width: 100%;">

    {%- if section.settings.layout_type == 'split' -%}
      <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: center; justify-content: space-between;" class="hero-split-grid">

        <!-- Left Column (Content) -->
        <div style="order: {% if section.settings.image_alignment == 'left' %}2{% else %}1{% endif %};">
          <!-- Subtle top tag -->
          {%- if section.settings.sub_heading_top != blank -%}
            <p style="font-size: 0.85rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
              <span style="display:inline-block; width: 10px; height: 1px; background: var(--color-accent);"></span>
              {{ section.settings.sub_heading_top | escape }}
            </p>
          {%- endif -%}

          <h1 class="glow-text" style="font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.03em;">
            {{ section.settings.heading | escape }}
          </h1>

          <p class="text-secondary" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.5rem; max-width: 550px;">
            {{ section.settings.description | escape }}
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
            {%- if section.settings.button_1_label != blank -%}
              <a href="{{ section.settings.button_1_link }}" class="btn btn-primary">
                {{ section.settings.button_1_label | escape }}
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a href="{{ section.settings.button_2_link }}" class="btn btn-secondary">
                {{ section.settings.button_2_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>

        <!-- Right Column (Hero Product/Promotional Image with Neon Border Glow) -->
        <div style="order: {% if section.settings.image_alignment == 'left' %}1{% else %}2{% endif %}; display: flex; justify-content: center; align-items: center;" class="hero-image-col">
          <div style="position: relative; width: 100%; max-width: {{ section.settings.image_max_width }}px;">
            <!-- Outer Glow shadow container -->
            <div style="position: absolute; inset: -4px; background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-purple) 100%); border-radius: {{ section.settings.image_border_radius }}px; opacity: 0.6; filter: blur(12px); z-index: -1;"></div>

            {%- if section.settings.image != blank -%}
              <img src="{{ section.settings.image | image_url: width: 1000 }}"
                   alt="{{ section.settings.heading | escape }}"
                   width="1000"
                   height="800"
                   loading="eager"
                   style="display: block; width: 100%; border-radius: {{ section.settings.image_border_radius }}px; border: 2px solid rgba(255, 255, 255, 0.08); aspect-ratio: {{ section.settings.image_aspect_ratio }}; object-fit: cover;">
            {%- else -%}
              <!-- Native Interactive SVG Placeholder for High-Tech gadgets -->
              <div style="background-color: var(--color-bg-secondary); width: 100%; border-radius: {{ section.settings.image_border_radius }}px; border: 1.5px dashed var(--color-accent); display: flex; flex-direction: column; justify-content: center; align-items: center; aspect-ratio: {{ section.settings.image_aspect_ratio }}; padding: 2rem;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent); margin-bottom: 1rem;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                <span style="font-weight: 700; color: var(--color-text-primary); font-size: 1.1rem; margin-bottom: 0.25rem;">PREMIUM SMARTPHONE STORE</span>
                <span style="font-size: 0.85rem; color: var(--color-text-secondary); text-align: center;">Curate trending tech, wellness & beauty gadgets</span>
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>
    {%- else -%}
      <!-- Default Full Background layout -->
      <div style="max-width: 650px;">
        <!-- Subtle top tag -->
        {%- if section.settings.sub_heading_top != blank -%}
          <p style="font-size: 0.85rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <span style="display:inline-block; width: 10px; height: 1px; background: var(--color-accent);"></span>
            {{ section.settings.sub_heading_top | escape }}
          </p>
        {%- endif -%}

        <h1 class="glow-text" style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.03em;">
          {{ section.settings.heading | escape }}
        </h1>

        <p class="text-secondary" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.5rem; max-width: 550px;">
          {{ section.settings.description | escape }}
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link }}" class="btn btn-primary">
              {{ section.settings.button_1_label | escape }}
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link }}" class="btn btn-secondary">
              {{ section.settings.button_2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  @media (max-width: 991px) {
    .hero-split-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
    .hero-split-grid > div {
      order: unset !important;
    }
    .hero-image-col {
      order: 2 !important;
    }
  }
</style>

{% schema %}
{
  "name": "Futuristic Hero",
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "Hero Layout Style",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "Split Screen (Side Image)"
        },
        {
          "value": "background",
          "label": "Background Image Overlay"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image (Side or Background)"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 35,
      "label": "Background Image Opacity (Only for Background mode)"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Side Image Position (Only for Split mode)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left Column"
        },
        {
          "value": "right",
          "label": "Right Column"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Side Image Aspect Ratio",
      "default": "1/1",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Standard (4:3)"
        },
        {
          "value": "16/9",
          "label": "Widescreen (16:9)"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 300,
      "max": 650,
      "step": 50,
      "default": 500,
      "unit": "px",
      "label": "Side Image Maximum Width"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 16,
      "unit": "px",
      "label": "Side Image Border Radius"
    },
    {
      "type": "text",
      "id": "sub_heading_top",
      "label": "Top Tagline",
      "default": "SYSTEM DISCOVERY IN PROGRESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the Future of Intelligent Gadgets"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Smartify Finds curated modern technology ecosystem is calibrated for maximum performance, smart living elegance, and unmatched productivity benefits."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Explore Gadgets"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    }
  ]
}
{% endschema %}

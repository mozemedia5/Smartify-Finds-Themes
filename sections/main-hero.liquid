<section style="position: relative; background-color: var(--color-bg-primary); overflow: hidden; min-height: calc(100vh - 120px); display: flex; align-items: center;">

  <!-- Media background background-color fallback -->
  {%- if section.settings.image != blank -%}
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           alt="{{ section.settings.heading | escape }}"
           width="2000"
           height="1000"
           loading="eager"
           style="object-fit: cover; width: 100%; height: 100%; opacity: 0.35; filter: grayscale(20%);">
    </div>
  {%- endif -%}

  <!-- Glow aesthetic overlays -->
  <div style="position: absolute; top: -10%; left: -10%; width: 50%; height: 50%; background: radial-gradient(circle, rgba(0, 240, 255, 0.15) 0%, transparent 70%); z-index: 2; pointer-events: none;"></div>
  <div style="position: absolute; bottom: -10%; right: -10%; width: 50%; height: 50%; background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 70%); z-index: 2; pointer-events: none;"></div>

  <!-- Content -->
  <div class="container" style="position: relative; z-index: 5; padding-top: 5rem; padding-bottom: 5rem;">
    <div style="max-width: 650px;">

      <!-- Subtle top tag -->
      {%- if section.settings.sub_heading_top != blank -%}
        <p style="font-size: 0.85rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="display:inline-block; width: 10px; height: 1px; background: var(--color-accent);"></span>
          {{ section.settings.sub_heading_top | escape }}
        </p>
      {%- endif -%}

      <h1 class="glow-text" style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.03em;">
        {{ section.settings.heading | escape }}
      </h1>

      <p class="text-secondary" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 2.5rem; max-width: 550px;">
        {{ section.settings.description | escape }}
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link }}" class="btn btn-primary">
            {{ section.settings.button_1_label | escape }}
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="btn btn-secondary">
            {{ section.settings.button_2_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Futuristic Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "sub_heading_top",
      "label": "Top Tagline",
      "default": "SYSTEM DISCOVERY IN PROGRESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the Future of Intelligent Gadgets"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Smartify Finds curated modern technology ecosystem is calibrated for maximum performance, smart living elegance, and unmatched productivity benefits."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Explore Gadgets"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    }
  ]
}
{% endschema %}

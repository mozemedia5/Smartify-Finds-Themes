<section class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem auto;">
    <h1 style="font-size: 2.75rem; font-weight: 900; margin-bottom: 1rem;">
      {{ 'general.search.heading' | t }}
    </h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top: 1.5rem;">
      <div style="display: flex; gap: 0.5rem;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="text-secondary" style="font-size: 1.2rem; text-align: center;">
        {{ 'general.search.no_results' | t: terms: search.terms }}
      </p>
    {%- else -%}
      <div class="grid grid-4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}

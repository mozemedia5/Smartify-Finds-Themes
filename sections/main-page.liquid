<section class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px;">
  {% render 'breadcrumbs' %}

  <h1 style="font-size: 2.75rem; font-weight: 900; margin-top: 2rem; margin-bottom: 2rem;">
    {{ page.title }}
  </h1>

  <div class="page-content text-secondary" style="font-size: 1.05rem; line-height: 1.7; display: flex; flex-direction: column; gap: 1.5rem;">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Standard Page",
  "settings": []
}
{% endschema %}

{% comment %}
  Renders the interactive Ajax slide-out cart drawer.
{% endcomment %}

<div id="cart-drawer-overlay" class="drawer-overlay"></div>

<div id="cart-drawer" class="drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
  <div class="drawer-header">
    <h2 id="cart-drawer-title" style="font-size: 1.25rem;">{{ 'general.cart.title' | t }}</h2>
    <button class="drawer-close" aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
  </div>

  <div class="drawer-body">
    <!-- Updated dynamically by theme.js Ajax updates -->
    <div style="text-align: center; padding: 2rem 0;">
      <p class="text-secondary" style="margin-bottom: 1rem;">{{ 'general.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">{{ 'general.cart.continue_shopping' | t }}</a>
    </div>
  </div>

  <div class="drawer-footer" style="display: none;">
    <!-- Dynamic subtotal and checkout buttons generated by theme.js -->
  </div>
</div>

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'structured-data' %}

    {{ content_for_header }}

    <style>
      :root {
        --color-bg-primary: {{ settings.color_bg_primary | default: '#0b0f19' }};
        --color-bg-secondary: {{ settings.color_bg_secondary | default: '#131b2e' }};
        --color-text-primary: {{ settings.color_text_primary | default: '#f3f4f6' }};
        --color-text-secondary: {{ settings.color_text_secondary | default: '#9ca3af' }};
        --color-accent: {{ settings.color_accent | default: '#00f0ff' }};
        --color-accent-purple: {{ settings.color_accent_purple | default: '#a855f7' }};
        --color-border: {{ settings.color_border | default: '#1f2937' }};
        --color-sale-badge: {{ settings.color_sale_badge | default: '#00f0ff' }};
        --color-new-badge: {{ settings.color_new_badge | default: '#10b981' }};
        --container-max-width: {{ settings.container_max_width | default: 1300 }}px;
        --border-radius: {{ settings.border_radius | default: 8 }}px;
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-{{ template.name | handle }} bg-primary text-primary">
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- if settings.enable_cart_drawer -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {% render 'predictive-search' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
